    StatusCorner.Parent = InfoStatus

    FarmButton.MouseButton1Click:Connect(function()
        _G.MegaDebugAttivo = not _G.MegaDebugAttivo
        if _G.MegaDebugAttivo then
            FarmButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
            FarmButton.Text = "ANALISI ATTIVA (CONTROLLA F9)"
            InfoStatus.Text = "📡 TRASMISSIONE PACCHETTI..."
