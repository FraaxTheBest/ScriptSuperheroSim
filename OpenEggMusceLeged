--===================================================================================
-- SENSORI INVISIBILI (HOOK): SPIANO OGNI FUNZIONE PRIMA CHE ARRIVI AL SERVER
--===================================================================================
local function AttivaSpiaTotale()
    local rEvents = ReplicatedStorage:WaitForChild("rEvents", 10)
    if not rEvents then print("[ERROR] Cartella rEvents non trovata!") return end

    -- 1. SPIA L'APERTURA DELL'UOVO (RemoteFunction)
    local openCrystal = rEvents:FindFirstChild("openCrystalRemote")
    if openCrystal and openCrystal:IsA("RemoteFunction") then
        local vecchioInvoke = openCrystal.InvokeServer
        openCrystal.InvokeServer = function(self, ...)
            local args = {...}
            print("\n🚨 [SPIATO PRIMA DI APRIRE]: Il gioco sta chiamando openCrystalRemote!")
            for i, v in ipairs(args) do
                print("   -> Parametro #" .. tostring(i) .. ": " .. tostring(v) .. " | Tipo: " .. typeof(v))
            end
            return vecchioInvoke(self, unpack(args))
        end
    end

    -- 2. SPIA LA VENDITA DEI PET (RemoteEvent)
    local sellPet = rEvents:FindFirstChild("sellPetEvent")
    if sellPet and sellPet:IsA("RemoteEvent") then
        local vecchioFire = sellPet.FireServer
        sellPet.FireServer = function(self, ...)
            local args = {...}
            print("\n💀 [SPIATO VENDITA PET]: Rilevato segnale di sellPetEvent!")
            for i, v in ipairs(args) do
                if typeof(v) == "Instance" then
                    print("   -> Pet venduto: " .. tostring(v.Name) .. " | Percorso: " .. v:GetFullName())
                else
                    print("   -> Parametro Vendita #" .. tostring(i) .. ": " .. tostring(v) .. " | Tipo: " .. typeof(v))
                end
            end
            vecchioFire(self, unpack(args))
        end
    end
end

--===================================================================================
-- SCANNER DELLE MODIFICHE (CONTROLLO DOPO L'APERTURA NATIVA)
--===================================================================================
-- Monitora se appaiono nuovi pet nello zaino delle leaderstats o dell'omino
local function ConfiguraScannerDopo()
    local targetPets = lPlayer:FindFirstChild("Pets") or (lPlayer:FindFirstChild("leaderstats") and lPlayer.leaderstats:FindFirstChild("Pets"))
    if targetPets then
        print("[TRACER] Sensore di controllo 'DOPO' agganciato alla cartella: " .. targetPets:GetFullName())
        targetPets.ChildAdded:Connect(function(nuovoPet)
            print("\n✨ [REGISTRATO DOPO L'APERTURA]: Un nuovo Pet è entrato nell'inventario!")
            print("   * Nome Pet Rilevato: " .. tostring(nuovoPet.Name))
            print("   * Verifico proprietà interne del modello:")
            for _, prop in ipairs(nuovoPet:GetChildren()) do
                print("     - Sotto-valore: " .. prop.Name .. " = " .. tostring(prop))
            end
        end)
    else
        warn("[WARNING] Impossibile trovare la cartella Pets! Apri un uovo a mano per farla caricare al gioco.")
    end
end

