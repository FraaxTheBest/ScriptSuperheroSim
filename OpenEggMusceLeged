                threadDebug = true
                avviaTestPacchetti()
            end
        else
            FarmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            FarmButton.Text = "AVVIA ANALISI DI RETE"
            InfoStatus.Text = "STATUS: ANALISI INTERROTTA"
        end
    end)

    -- TOGGLE MINIMIZZA
