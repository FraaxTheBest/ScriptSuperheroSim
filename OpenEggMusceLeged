--===================================================================================
-- TRIXADE MUSCLE LEGENDS - INDUSTRIAL CRYSTAL AUTOFARM (PRO-VERSION)
-- FIX INVOKESERVER CORRETTO + AUTO-SELL SELETTIVO + MINIMIZZA/CHIUDI
--===================================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local lPlayer = Players.LocalPlayer
local pGui = lPlayer:WaitForChild("PlayerGui")

local openCrystalRemote = ReplicatedStorage:WaitForChild("rEvents"):WaitForChild("openCrystalRemote")
local sellPetEvent = ReplicatedStorage:WaitForChild("rEvents"):WaitForChild("sellPetEvent")

_G.AutoEggAttivo = false
local CRYSTAL_NAME = "Industrial Crystal"
local PET_DA_SALVARE = "Apex Overlord"

--===================================================================================
-- ENGINE DI APERTURA E FILTRO VENDITA PET
--===================================================================================
local eggThreadAttivo = false

local function eseguiAutoEgg()
    task.spawn(function()
        print("[EGG CORE] Avvio ciclo d'acquisto sbloccato.")
        while _G.AutoEggAttivo do
            
            -- FIX SINTASSI: Chiama il server con la s minuscola (InvokeServer)
            local successo, risultato = pcall(function()
                return openCrystalRemote:InvokeServer(CRYSTAL_NAME)
            end)
            
            -- SCANSIONE CARTELLA PET (CORRETTA DENTRO LEADERSTATS)
            local leaderstats = lPlayer:FindFirstChild("leaderstats")
            local folderPet = leaderstats and leaderstats:FindFirstChild("Pets")
            
            if folderPet then
                local listaPet = folderPet:GetChildren()
                for i = 1, #listaPet do
                    if not _G.AutoEggAttivo then break end
                    local pet = listaPet[i]
                    
                    -- Se il nome NON è Apex Overlord, lo vende all'istante
                    if pet.Name ~= PET_DA_SALVARE then
                        pcall(function()
                            sellPetEvent:FireServer(pet)
                        end)
                    else
                        print("[MEGA DROP!] Apex Overlord trovato e salvato dal filtro!")
                    end
                end
            end
            
            -- Pausa fissa a frame per non far laggare BlueStacks
            task.wait(0.2)
        end
        eggThreadAttivo = false
        print("[EGG CORE] Ciclo terminato.")
    end)
end

function AvviaAutoEgg()
    if eggThreadAttivo then return end
    eggThreadAttivo = true
    eseguiAutoEgg()
end

--===================================================================================
-- CREAZIONE INTERFACCIA GRAFICA COMPATTA (CON DISCONNESSIONI SICURE)
--===================================================================================
local function CreaInterfaccia()
    local screenName = "MuscleLegends_Egg_Gui"
    local vecchioScreen = pGui:FindFirstChild(screenName)
    if vecchioScreen then vecchioScreen:Destroy() end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = screenName
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = pGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 240, 0, 160)
    MainFrame.Position = UDim2.new(0.5, -120, 0.4, -80)
    MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Parent = ScreenGui

    local FrameCorner = Instance.new("UICorner")
    FrameCorner.CornerRadius = UDim.new(0, 10)
    FrameCorner.Parent = MainFrame

    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Size = UDim2.new(1, 0, 0, 35)
    Title.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    Title.Text = "TRIXADE EGG MANAGER"
    Title.TextColor3 = Color3.fromRGB(255, 215, 0)
    Title.TextSize = 13
    Title.Font = Enum.Font.SourceSansBold
    Title.Parent = MainFrame

    local TitleCorner = Instance.new("UICorner")
    TitleCorner.CornerRadius = UDim.new(0, 10)
    TitleCorner.Parent = Title

    -- Drag Touch Mobile Delta Fix
    local dragging, dragInput, dragStart, startPos
    Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    Title.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    local dragConnection = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and MainFrame.Parent then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local FarmButton = Instance.new("TextButton")
    FarmButton.Name = "FarmButton"
    FarmButton.Size = UDim2.new(0, 200, 0, 40)
    FarmButton.Position = UDim2.new(0.5, -100, 0, 50)
    FarmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    FarmButton.Text = "AUTO EGG: DISATTIVATO"
    FarmButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    FarmButton.TextSize = 13
    FarmButton.Font = Enum.Font.SourceSansBold
    FarmButton.Parent = MainFrame

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 8)
    ButtonCorner.Parent = FarmButton

    local InfoStatus = Instance.new("TextLabel")
    InfoStatus.Name = "InfoStatus"
    InfoStatus.Size = UDim2.new(0, 200, 0, 30)
    InfoStatus.Position = UDim2.new(0.5, -100, 0, 105)
    InfoStatus.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    InfoStatus.Text = "💎 KEEP: APEX OVERLORD ONLY"
    InfoStatus.TextColor3 = Color3.fromRGB(100, 255, 255)
    InfoStatus.TextSize = 11
    InfoStatus.Font = Enum.Font.SourceSansBold
    InfoStatus.Parent = MainFrame

    local StatusCorner = Instance.new("UICorner")
    StatusCorner.CornerRadius = UDim.new(0, 6)
    StatusCorner.Parent = InfoStatus

    FarmButton.MouseButton1Click:Connect(function()
        _G.AutoEggAttivo = not _G.AutoEggAttivo
        if _G.AutoEggAttivo then
            FarmButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
            FarmButton.Text = "OPENING ACTIVE... 🥚⚡"
            AvviaAutoEgg()
        else
            FarmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            FarmButton.Text = "AUTO EGG: DISATTIVATO"
        end
    end)

    -- CONTROLLO MINIMIZZA (— / +)
    local minimized = false
    local MinButton = Instance.new("TextButton")
    MinButton.Name = "MinButton"
    MinButton.Size = UDim2.new(0, 26, 0, 22)
    MinButton.Position = UDim2.new(1, -60, 0, 6)
    MinButton.BackgroundColor3 = Color3.fromRGB(75, 75, 80)
    MinButton.Text = "—"
    MinButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    MinButton.TextSize = 16
    MinButton.Font = Enum.Font.SourceSansBold
    MinButton.Parent = MainFrame

    local MinCorner = Instance.new("UICorner")
    MinCorner.CornerRadius = UDim.new(0, 5)
    MinCorner.Parent = MinButton

    -- CONTROLLO CHIUDI (×)
    local CloseButton = Instance.new("TextButton")
    CloseButton.Name = "CloseButton"
    CloseButton.Size = UDim2.new(0, 26, 0, 22)
    CloseButton.Position = UDim2.new(1, -30, 0, 6)
    CloseButton.BackgroundColor3 = Color3.fromRGB(190, 50, 50)
    CloseButton.Text = "×"
    CloseButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseButton.TextSize = 16
    CloseButton.Font = Enum.Font.SourceSansBold
    CloseButton.Parent = MainFrame

    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(0, 5)
    CloseCorner.Parent = CloseButton

    local content = { FarmButton, InfoStatus }

    MinButton.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            MainFrame.Size = UDim2.new(0, 240, 0, 35)
            for i = 1, #content do content[i].Visible = false end
            MinButton.Text = "+"
        else
            MainFrame.Size = UDim2.new(0, 240, 0, 160)
            for i = 1, #content do content[i].Visible = true end
            MinButton.Text = "—"
        end
    end)

    CloseButton.MouseButton1Click:Connect(function()
        _G.AutoEggAttivo = false
        pcall(function() if dragConnection then dragConnection:Disconnect() end end)
        ScreenGui:Destroy()
        print("[GUI] Chiusura completata.")
    end)
end

CreaInterfaccia()
