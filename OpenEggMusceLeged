--===================================================================================
-- TRIXADE MUSCLE LEGENDS - ULTIMATE TALKING EGG CORE (UNIVERSAL PATH FIX)
-- LOG VERBALIZZATI DOPO APERTURA + AUTO-SELL FILTER + MINIMIZZA/CHIUDI
--===================================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local lPlayer = Players.LocalPlayer
local pGui = lPlayer:WaitForChild("PlayerGui")

local openCrystalRemote = ReplicatedStorage
    :WaitForChild("rEvents")
    :WaitForChild("openCrystalRemote")

local sellPetEvent = ReplicatedStorage
    :WaitForChild("rEvents")
    :WaitForChild("sellPetEvent")

_G.AutoEggAttivo = false

local CRYSTAL_NAME = "Industrial Crystal"
local PET_DA_SALVARE = "Apex Overlord"

--===================================================================================
-- INTERCETTATORE UNIVERSALE CARTELLA PET E VENDITA FLAMING
--===================================================================================

local eggThreadAttivo = false

local function trovaCartellaPetReale()
    -- Prova 1: Percorso leaderstats classico
    if lPlayer:FindFirstChild("leaderstats")
        and lPlayer.leaderstats:FindFirstChild("Pets")
    then
        return lPlayer.leaderstats.Pets
    end

    -- Prova 2: Percorso diretto LocalPlayer
    if lPlayer:FindFirstChild("Pets") then
        return lPlayer.Pets
    end

    if lPlayer:FindFirstChild("PetFolder") then
        return lPlayer.PetFolder
    end

    -- Prova 3: Percorso Workspace
    local workspacePets =
        workspace:FindFirstChild("Pets")
        or workspace:FindFirstChild("PlayerPets")

    if workspacePets then
        local userFolder =
            workspacePets:FindFirstChild(lPlayer.Name)
            or workspacePets:FindFirstChild(tostring(lPlayer.UserId))

        if userFolder then
            return userFolder
        end
    end

    -- Prova 4: DataFolder interna
    local dataFolder =
        lPlayer:FindFirstChild("DataFolder")
        or lPlayer:FindFirstChild("Data")

    if dataFolder and dataFolder:FindFirstChild("Pets") then
        return dataFolder.Pets
    end

    return nil
end

local function eseguiAutoEgg()
    task.spawn(function()
        print("[EGG CORE] Loop di vendita istantanea forzato avviato.")

        while _G.AutoEggAttivo do
            -- 1. INVIO COMANDO DI APERTURA AL SERVER
            local successo, risultato = pcall(function()
                return openCrystalRemote:InvokeServer(CRYSTAL_NAME)
            end)

            if successo then
                print(
                    "[SERVER INPUT] Uovo aperto. Sincronizzo filtri zaino..."
                )

                task.wait(0.2)
            end

            -- 2. SCANSIONE CON FILTRO DI PROTEZIONE APEX OVERLORD
            local folderPet = trovaCartellaPetReale()

            if folderPet then
                local listaPet = folderPet:GetChildren()

                for i = 1, #listaPet do
                    if not _G.AutoEggAttivo then
                        break
                    end

                    local pet = listaPet[i]

                    if pet.Name ~= PET_DA_SALVARE then
                        print(
                            "[AUTO-SELL] Rilevato pet comune: "
                            .. tostring(pet.Name)
                            .. " -> Vendo..."
                        )

                        pcall(function()
                            sellPetEvent:FireServer(pet)
                        end)
                    else
                        print(
                            "[MEGA DROP DETECTED!] "
                            .. PET_DA_SALVARE
                            .. " salvato con successo!"
                        )
                    end
                end
            else
                -- Fallback nel Backpack
                print(
                    "[FALLBACK] Tento pulizia forzata tramite scansione dell'inventario..."
                )

                local inv = lPlayer:FindFirstChildOfClass("Backpack")

                if inv then
                    for _, item in ipairs(inv:GetChildren()) do
                        if item.Name ~= PET_DA_SALVARE
                            and (
                                item:Card("Pet")
                                or item.ClassName:match("Pet")
                            )
                        then
                            sellPetEvent:FireServer(item)
                        end
                    end
                end
            end

            task.wait(0.3)
        end

        eggThreadAttivo = false

        print("[EGG CORE] Loop completamente terminato.")
    end)
end

function AvviaAutoEgg()
    if eggThreadAttivo then
        return
    end

    eggThreadAttivo = true
    eseguiAutoEgg()
end

--===================================================================================
-- CREAZIONE INTERFACCIA GRAFICA COMPATTA CON TOGGLES COMPLETI
--===================================================================================

local function CreaInterfaccia()
    local screenName = "MuscleLegends_Egg_Gui"
    local vecchioScreen = pGui:FindFirstChild(screenName)

    if vecchioScreen then
        vecchioScreen:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = screenName
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = pGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 240, 0, 160)
    MainFrame.Position = UDim2.new(0.5, -120, 0.4, -80)
    MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Parent = ScreenGui

    local FrameCorner = Instance.new("UICorner")
    FrameCorner.CornerRadius = UDim.new(0, 10)
    FrameCorner.Parent = MainFrame

    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Size = UDim2.new(1, 0, 0, 35)
    Title.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    Title.Text = "TRIXADE EGG LOGS v7"
    Title.TextColor3 = Color3.fromRGB(255, 215, 0)
    Title.TextSize = 13
    Title.Font = Enum.Font.SourceSansBold
    Title.Parent = MainFrame

    local TitleCorner = Instance.new("UICorner")
    TitleCorner.CornerRadius = UDim.new(0, 10)
    TitleCorner.Parent = Title

    -- Drag Touch Mobile
    local dragging
    local dragInput
    local dragStart
    local startPos

    Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    Title.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        then
            dragInput = input
        end
    end)

    local dragConnection =
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput
                and dragging
                and MainFrame.Parent
            then
                local delta = input.Position - dragStart

                MainFrame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)

    -- Farm button
    local FarmButton = Instance.new("TextButton")
    FarmButton.Name = "FarmButton"
    FarmButton.Size = UDim2.new(0, 200, 0, 40)
    FarmButton.Position = UDim2.new(0.5, -100, 0, 50)
    FarmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    FarmButton.Text = "AUTO EGG: DISATTIVATO"
    FarmButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    FarmButton.TextSize = 13
    FarmButton.Font = Enum.Font.SourceSansBold
    FarmButton.Parent = MainFrame

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 8)
    ButtonCorner.Parent = FarmButton

    local InfoStatus = Instance.new("TextLabel")
    InfoStatus.Name = "InfoStatus"
    InfoStatus.Size = UDim2.new(0, 200, 0, 30)
    InfoStatus.Position = UDim2.new(0.5, -100, 0, 105)
    InfoStatus.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    InfoStatus.Text = "💎 PATH SCANNER OPERATIONAL"
    InfoStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
    InfoStatus.TextSize = 11
    InfoStatus.Font = Enum.Font.SourceSansBold
    InfoStatus.Parent = MainFrame

    local StatusCorner = Instance.new("UICorner")
    StatusCorner.CornerRadius = UDim.new(0, 6)
    StatusCorner.Parent = InfoStatus

    FarmButton.MouseButton1Click:Connect(function()
        _G.AutoEggAttivo = not _G.AutoEggAttivo

        if _G.AutoEggAttivo then
            FarmButton.BackgroundColor3 =
                Color3.fromRGB(50, 180, 50)

            FarmButton.Text =
                "FARMING & AUTO-SELL ACTIVE"

            AvviaAutoEgg()
        else
            FarmButton.BackgroundColor3 =
                Color3.fromRGB(200, 50, 50)

            FarmButton.Text =
                "AUTO EGG: DISATTIVATO"
        end
    end)

    -- CONTROLLO MINIMIZZA
    local minimized = false

    local MinButton = Instance.new("TextButton")
    MinButton.Name = "MinButton"
    MinButton.Size = UDim2.new(0, 26, 0, 22)
    MinButton.Position = UDim2.new(1, -60, 0, 6)
    MinButton.BackgroundColor3 = Color3.fromRGB(75, 75, 80)
    MinButton.Text = "—"
    MinButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    MinButton.TextSize = 16
    MinButton.Font = Enum.Font.SourceSansBold
    MinButton.ZIndex = 10
    MinButton.Parent = MainFrame

    local MinCorner = Instance.new("UICorner")
    MinCorner.CornerRadius = UDim.new(0, 5)
    MinCorner.Parent = MinButton

    -- CONTROLLO CHIUDI
    local CloseButton = Instance.new("TextButton")
    CloseButton.Name = "CloseButton"
    CloseButton.Size = UDim2.new(0, 26, 0, 22)
    CloseButton.Position = UDim2.new(1, -30, 0, 6)
    CloseButton.BackgroundColor3 = Color3.fromRGB(190, 50, 50)
    CloseButton.Text = "×"
    CloseButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseButton.TextSize = 16
    CloseButton.Font = Enum.Font.SourceSansBold
    CloseButton.ZIndex = 10
    CloseButton.Parent = MainFrame

    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(0, 5)
    CloseCorner.Parent = CloseButton

    local content = {
        FarmButton,
        InfoStatus
    }

    MinButton.MouseButton1Click:Connect(function()
        minimized = not minimized

        if minimized then
            MainFrame.Size = UDim2.new(0, 240, 0, 35)

            for i = 1, #content do
                if content[i] then
                    content[i].Visible = false
                end
            end

            MinButton.Text = "+"
        else
            MainFrame.Size = UDim2.new(0, 240, 0, 160)

            for i = 1, #content do
                if content[i] then
                    content[i].Visible = true
                end
            end

            MinButton.Text = "—"
        end
    end)

    CloseButton.MouseButton1Click:Connect(function()
        _G.AutoEggAttivo = false

        pcall(function()
            if dragConnection then
                dragConnection:Disconnect()
            end
        end)

        ScreenGui:Destroy()

        print("[GUI] Chiusura completata.")
    end)
end

CreaInterfaccia()
