    ButtonCorner.Parent = FarmButton

    local InfoStatus = Instance.new("TextLabel")
    InfoStatus.Name = "InfoStatus"
    InfoStatus.Size = UDim2.new(0, 210, 0, 30)
    InfoStatus.Position = UDim2.new(0.5, -105, 0, 110)
