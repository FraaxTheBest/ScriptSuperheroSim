--===================================================================================
-- COSTRUTTORE DI SPAM MULTI-ARGOMENTO (TEST AUTOMATICO DEL COINVOLGIMENTO)
--===================================================================================
_G.MegaDebugAttivo = false
local threadDebug = false

local function avviaTestPacchetti()
    task.spawn(function()
        print("[DEBUG ENGINE] Avvio bombardamento sperimentale parametri.")
        local remote = ReplicatedStorage:WaitForChild("rEvents"):WaitForChild("openCrystalRemote")
        
        while _G.MegaDebugAttivo do
            -- Il server potrebbe richiedere argomenti aggiuntivi: testiamo tutte le varianti note
            pcall(function()
                -- Variante 1: Solo nome stringa (Classica)
                remote:FireServer("Industrial Crystal")
                -- Variante 2: Nome + quantità numerica (Single)
                remote:FireServer("Industrial Crystal", 1)
                -- Variante 3: Nome + Stringa quantità (Triple / Single)
                remote:FireServer("Industrial Crystal", "Single")
                -- Variante 4: Solo nome troncato update
                remote:FireServer("Industrial")
            end)
            
            -- Tracciamento dinamico errori interni di Roblox
            task.wait(0.5)
        end
        threadDebug = false
        print("[DEBUG ENGINE] Bombardamento terminato.")
    end)
end

--===================================================================================
-- INTERFACCIA INTERATTIVA COMPATTA CON INTERRUTTORI MINIMIZZA E CHIUDI
